# The admin panel stays out of git. Only the database connection file is tracked,
# so a pull on tools.kasdo.org creates admin/classes/connection.php.
/admin/*
!/admin/classes/
/admin/classes/*
!/admin/classes/connection.php
/air-datepicker-master
# Keep uploaded pictures out of git. CSS, scripts, and the logo/hero pictures are required for the live UI.
