RewriteRule ^freeonlinecourseswithcertificates/?$ /free-online-courses-with-certificates [R=301,NC,L]
RewriteRule ^Resources/logo_images/OHSC(\s|%20)Prospectus\.pdf$ /courses [R=301,NC,L]
