# Website Firewall Bypass Prevention (origin IP whitelist) removed for S-010:
# that rule could block Googlebot when enforced at Apache/LiteSpeed level.
# Enforce WAF/CDN restrictions at the hosting edge instead of origin .htaccess.

RewriteEngine On

# ORIGINAL production rule: force every request to https://www.oxfordhomestudy.com
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.oxfordhomestudy.com/$1 [R=301,L]
# LOCAL CHANGE: localhost and 127.0.0.1 stay on this machine (http://localhost:300) instead of redirecting to the live site.
# RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
# RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.oxfordhomestudy.com/$1 [R=301,L]
# TOOLS HOST: tools.kasdo.org stays on this domain. www is folded onto the bare host, and http is upgraded to https.
# The host check is unanchored so a port or a trailing dot still counts as this site.
RewriteCond %{HTTP_HOST} ^www\.tools\.kasdo\.org [NC]
RewriteRule ^(.*)$ https://tools.kasdo.org/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^tools\.kasdo\.org [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://tools.kasdo.org/$1 [R=301,L]
# ORIGINAL production redirect: every other host was sent to https://www.oxfordhomestudy.com
# RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
# RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
# RewriteCond %{HTTP_HOST} !tools\.kasdo\.org [NC]
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.oxfordhomestudy.com/$1 [R=301,L]
# TOOLS HOST: this branch is served on tools.kasdo.org, so that redirect is off.

RewriteCond %{QUERY_STRING} (^|&)category=industry-insights(&|$) [NC]
RewriteRule ^OHSC-Blog/?$ /OHSC-Blog? [R=301,NC,L]

# Redirect any URL with utm_* query parameter to home page
RewriteCond %{QUERY_STRING} (^|&)utm_[^=]*= [NC]
RewriteRule ^ /? [R=302,L]

# Begin query-string strip redirects (must precede query-string 410 block)
RewriteCond %{QUERY_STRING} ^ref=ratrating\.com$ [NC]
RewriteRule ^$ /? [R=301,L]
RewriteCond %{QUERY_STRING} ^ref=techpacker\.com$ [NC]
RewriteRule ^fashion-designing-online-courses-free/?$ /fashion-designing-online-courses-free? [R=301,NC,L]
RewriteCond %{QUERY_STRING} ^trk=public_profile_see-credential$ [NC]
RewriteRule ^free-online-courses-with-certificates/?$ /free-online-courses-with-certificates? [R=301,NC,L]
RewriteCond %{QUERY_STRING} ^_ga=2\.43547301\.1837794599\.1612903104-429969036\.1612903104\?_ga%3D2\.43547301\.1837794599\.1612903104-429969036\.1612903104$ [NC]
RewriteRule ^free-online-courses-with-certificates/?$ /free-online-courses-with-certificates? [R=301,NC,L]
RewriteCond %{QUERY_STRING} ^_ga=2\.55303915\.1351810455\.1607678439-209839518\.1607678439\?utm_source\?fbclid$ [NC]
RewriteRule ^free-online-courses-with-certificates/?$ /free-online-courses-with-certificates? [R=301,NC,L]
# End query-string strip redirects

RewriteCond %{QUERY_STRING} .+
RewriteRule ^courses/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)$ /course.php?slug2=$1&slug=$2 [L,QSA]
RewriteCond %{THE_REQUEST} \s/blog-landing\.php[\s?] [NC]
RewriteRule ^blog-landing\.php$ /OHSC-Blog [R=301,L]
# Begin code to return 410 instead for 404 for images
RewriteCond %{REQUEST_URI} ^/images/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule .* - [G,L]
# End code to return 410 instead for 404 for images

# Block all query strings except allowed ones
RewriteCond %{QUERY_STRING} .+
RewriteCond %{REQUEST_URI} !^/admin/ [NC]
RewriteCond %{REQUEST_URI} !^/assets/ [NC]
RewriteCond %{REQUEST_URI} !^/fonts/ [NC]
RewriteCond %{REQUEST_URI} !^/images/ [NC]
RewriteCond %{REQUEST_URI} !^/css/ [NC]
RewriteCond %{REQUEST_URI} !^/design-two/css/ [NC]
RewriteCond %{REQUEST_URI} !^/design-three/assets/ [NC]
RewriteCond %{REQUEST_URI} !^/js/ [NC]
RewriteCond %{REQUEST_URI} !^/jquery-modal-master/ [NC]
RewriteCond %{REQUEST_URI} !^/lms/ [NC]
# TOOLS: /tools is a separate module. Its admin screens use the same ?id= links as the rest of the admin panel.
RewriteCond %{REQUEST_URI} !^/tools/ [NC]
RewriteCond %{REQUEST_URI} !^/Resources/admin_css/ [NC]
RewriteCond %{REQUEST_URI} !^/ajax/general\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/ajax/blog-category-posts\.php$ [NC]
# Allow internal pretty-URL routers (page.php, course/category/blog routers)
RewriteCond %{REQUEST_URI} !^/page\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/classification_category\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/course\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/post\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/faq\.php$ [NC]
RewriteCond %{REQUEST_URI} !^/footerlink\.php$ [NC]
# Allow ONLY: /courses/<one-segment>?type=free|endorsed|regulated
RewriteCond %{REQUEST_URI} !^/courses/[^/]+$ [NC,OR]
RewriteCond %{QUERY_STRING} !^type=(free|endorsed|regulated)$ [NC]
# Allow: /applyonline?msg=<anything>
RewriteCond %{REQUEST_URI} !^/applyonline$ [NC,OR]
RewriteCond %{QUERY_STRING} !^msg=.*$ [NC]
RewriteRule ^ - [G,L]

# Essential site routing (must appear before large redirect blocks)
RewriteRule ^sitemap\.html$ /sitemap.xml [R=301,L]
RewriteRule ^contact.php$ /contact [R=301,NC,L]
RewriteRule ^aboutus.php$ /aboutus [R=301,NC,L]
RewriteRule ^blog.php$ /OHSC-Blog [R=301,NC,L]
RewriteRule ^classification.php$ /courses [R=301,NC,L]
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^distance-learning.php$ /distance-learning [R=301,NC,L]
RewriteRule ^form.php$ /form [R=301,NC,L]
RewriteRule ^free-courses.php$ /free-online-courses-with-certificates [R=301,NC,L]
RewriteRule ^how-to-pay.php$ /how-to-pay [R=301,NC,L]
RewriteRule ^thankyou.php$ /thanks [R=301,NC,L]
RewriteRule ^video-sharing-guide.php$ /video-sharing-guide [R=301,NC,L]

RewriteRule ^TermsAndConditions.php$ /terms-and-conditions [R=301,NC,L]
RewriteRule ^policy.php$ /privacy-policy [R=301,NC,L]
RewriteRule ^apply.php$ /applyonline [R=301,NC,L]
RewriteRule ^apply_target.php$ /apply_target [R=301,NC,L]
RewriteRule ^voucher-redemption.php$ /voucher-redemption [R=301,NC,L]
RewriteRule ^allCourses\.php$ /courses [R=301,NC,L]
RewriteRule ^allCourses/?$ /courses [R=301,NC,L]
RewriteRule ^free-online-courses-with-certificates\.php$ /free-online-courses-with-certificates [R=301,NC,L]
RewriteRule ^courses/secretarial-courses/office-administration-courses-online-free/?$ /office-administration-courses-online-free [R=301,NC,L]
RewriteRule ^courses/life-coaching-courses-online/free-life-coaching-courses/?$ /free-life-coaching-courses [R=301,NC,L]
RewriteRule ^courses/teaching-assistant-courses-online/free-teaching-assistant-courses/?$ /free-teaching-assistant-courses [R=301,NC,L]
RewriteRule ^courses/hospitality-management-courses-online/free-hospitality-courses/?$ /free-hospitality-courses [R=301,NC,L]
RewriteRule ^courses/courses-in-security-management/advanced-diploma-in-security-management/?$ /courses/courses-in-security-management/ai-for-security-monitoring [R=301,NC,L]
